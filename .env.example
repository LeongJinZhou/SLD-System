# Configure using university-owned Google Cloud OAuth credentials. Never commit .env.
# Set these in the launching shell; the server deliberately does not read arbitrary .env files.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DIRECTORY_ENABLED=true
SLD_ADMIN_EMAILS=
SLD_APP_URL=http://127.0.0.1:8765
# Optional renderer executable; automatically discovers .tools/libreoffice when available.
SOFFICE_PATH=

# Optional retrieval-augmented generation. Off by default; server secrets only.
SLD_ASSISTANT_GENERATION_ENABLED=false
OPENAI_API_KEY=
SLD_ASSISTANT_MODEL=
